{
  "version": 2,
  "buildCommand": "npm run build:all",
  "outputDirectory": "frontend/build",
  "public": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "backend/api/index.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "env": [
    "MONGODB_URI",
    "JWT_SECRET",
    "TMDB_API_KEY",
    "TMDB_BEARER_TOKEN",
    "JWT_EXPIRES_IN",
    "NODE_ENV",
    "FRONTEND_URL"
  ]
}
