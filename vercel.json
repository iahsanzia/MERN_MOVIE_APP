{
  "version": 2,
  "buildCommand": "npm run install:all && npm run build:all",
  "outputDirectory": "frontend/build",
  "public": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
