{
  "version": 2,
  "buildCommand": "npm run build:all",
  "outputDirectory": "frontend/build",
  "public": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "backend/api/index.ts": {
      "runtime": "nodejs20.x"
    }
  }
}
